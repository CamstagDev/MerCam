{
  "name": "mercam",
  "version": "0.1.0",
  "private": true,
  "description": "MerCam: arma tu lista del súper y compara precios entre los supermercados de tu zona",
  "type": "module",
  "author": "CamstagDev",
  "scripts": {
    "dev": "vite",
    "servidor": "node servidor/index.ts",
    "servidor:dev": "node --watch servidor/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/gradle.mjs assembleDebug",
    "version:nueva": "node scripts/nueva-version.mjs",
    "importar:cambasket": "node scripts/importar-cambasket.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capgo/nativegeocoder": "^8.0.31",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
